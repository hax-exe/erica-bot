NODELINK_SERVER_HOST=0.0.0.0
NODELINK_SERVER_PORT=3000
NODELINK_SERVER_PASSWORD=youshallnotpass
NODELINK_SOURCES_SPOTIFY_ENABLED=true
NODELINK_SOURCES_YOUTUBE_ENABLED=true
NODELINK_SOURCES_YOUTUBE_CIPHER_URL=https://cipher.kikkia.dev/api
# Android + Web implement SABR (serverAbrStreamingUrl). AndroidVR/TV/IOS do not —
# putting those first caused "No streaming data" → SoundCloud rip fallbacks.
NODELINK_SOURCES_YOUTUBE_CLIENTS_SEARCH=["Android"]
# Android first for SABR; Music early for YouTube Music encodes / better metadata paths.
NODELINK_SOURCES_YOUTUBE_CLIENTS_PLAYBACK=["Android","Music","Web","TV","WebEmbedded","IOS"]
NODELINK_SOURCES_YOUTUBE_CLIENTS_RESOLVE=["Android","Music","Web","TV","WebEmbedded","IOS"]
# NodeLink ignores empty [] (JS falsy). Prefer Deezer (clean encodes) over SoundCloud rips.
# Note: NodeLink ALSO hardcodes soundcloud/deezer/… after this list — disable SC below.
NODELINK_SOURCES_YOUTUBE_FALLBACKSOURCES=["deezer"]
# SC disabled so YT stream failures don't play low-quality "[Download]" rips.
# Must also rewrite default search lists (they include soundcloud by default).
NODELINK_SOURCES_SOUNDCLOUD_ENABLED=false
NODELINK_DEFAULTSEARCHSOURCE=["youtube","deezer"]
NODELINK_UNIFIEDSEARCHSOURCES=["youtube","deezer"]
NODELINK_SOURCES_JIOSAAVN_ENABLED=false
NODELINK_SOURCES_GAANA_ENABLED=false
NODELINK_AUDIO_QUALITY=high
NODELINK_AUDIO_RESAMPLINGQUALITY=best
NODELINK_LOGGING_LEVEL=info
NODELINK_LOGGING_DEBUG_ALL=false
NODELINK_LOGGING_DEBUG_YOUTUBE=false
NODELINK_LOGGING_DEBUG_SABR=false
NODELINK_CLUSTER_ENABLED=false
