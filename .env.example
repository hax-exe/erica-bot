# Erica — environment variables
# Copy to .env.dev (`bun dev`) and/or .env.prod (`bun start`, `bun run db:migrate`, Docker Compose).
# Real env files are git-ignored; only this example is committed.

# ── Discord ───────────────────────────────────────────────────────────────────
# Required. Bot token from the Developer Portal (your app → Bot).
DISCORD_TOKEN=
# Comma-separated Discord user IDs allowed to use bot-owner commands (/admin, …)
BOT_OWNER_IDS=
# Privileged Presence intent (presence-update logging + the "Online" server-stats counter).
# Set to true ONLY after enabling "Presence Intent" in the Developer Portal — otherwise login fails (4014).
DISCORD_PRESENCE_INTENT=false

# ── Database (MySQL) ──────────────────────────────────────────────────────────
# Required. Pending migrations in drizzle/ are applied automatically at startup.
DATABASE_URL=mysql://erica:password@localhost:3306/erica

# Docker Compose only: the bundled MySQL container. Compose builds the bot's DATABASE_URL from these.
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=erica
MYSQL_USER=erica
MYSQL_PASSWORD=changeme

# ── Music (NodeLink, Lavalink-compatible) ─────────────────────────────────────
# Compose overrides HOST/PORT/SECURE to reach its bundled `nodelink` container.
LAVALINK_HOST=localhost
LAVALINK_PORT=3000
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
# Optional: Spotify search/autocomplete (Compose also passes these to NodeLink)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional, Compose only: YouTube cipher token for NodeLink
NODELINK_SOURCES_YOUTUBE_CIPHER_TOKEN=

# ── Social feeds ──────────────────────────────────────────────────────────────
# Optional: Twitch live notifications in /feed (app credentials from dev.twitch.tv)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Status alerts ─────────────────────────────────────────────────────────────
# Optional fallbacks when alerts.channelId / alerts.roleId are not set in config/status.yml
STATUS_ALERT_CHANNEL_ID=
STATUS_ALERT_ROLE_ID=

# ── Minecraft ─────────────────────────────────────────────────────────────────
# Public server address shown in verification instructions and used as the /minecraft status default
MINECRAFT_SERVER_IP=
# Guild where Minecraft verification happens, and the role granted once verified
VERIFICATION_GUILD_ID=
VERIFIED_ROLE_ID=

# ── HTTP API (website / Minecraft plugin / portal sync) ───────────────────────
# /api/health, /api/status and /api/team are always served on BOT_API_PORT.
# Private routes (verification, transcripts, role sync, DMs) need BOT_API_ENABLED=true AND BOT_API_SECRET.
BOT_API_ENABLED=false
BOT_API_PORT=3001
BOT_API_SECRET=
# Comma-separated browser origins allowed by CORS, e.g. https://example.com,https://www.example.com
API_ALLOWED_ORIGINS=
# Website portal base URL for verified-profile/rank sync (authenticates with BOT_API_SECRET)
PORTAL_API_URL=
# /api/team lists members of TEAM_ROLE_ID in SUPPORT_GUILD_ID
SUPPORT_GUILD_ID=
TEAM_ROLE_ID=

# Discord role IDs for website ranks (portal sync picks the highest match).
# /api/guild/set-roles may only add/remove these (except LEADERSHIP/ADMIN) plus VERIFIED_ROLE_ID.
DISCORD_ROLE_LEADERSHIP=
DISCORD_ROLE_ADMIN=
DISCORD_ROLE_COMMUNITY_MANAGER=
DISCORD_ROLE_DEVELOPER=
DISCORD_ROLE_SENIOR_MODERATOR=
DISCORD_ROLE_MODERATOR=
DISCORD_ROLE_JR_MODERATOR=
DISCORD_ROLE_HELPER=
DISCORD_ROLE_BUILDER=
